{
  "name": "personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pages:dev": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist",
    "db:create": "wrangler d1 create personal-site-db",
    "db:migrate": "wrangler d1 execute personal-site-db --local --file=./migrations/0001_init.sql",
    "db:seed": "wrangler d1 execute personal-site-db --local --file=./seed.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241004.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "lucide-react": "^0.451.0",
    "postcss": "^8.5.0",
    "react-icons": "^5.3.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wrangler": "^3.80.0"
  },
  "allowScripts": {
    "workerd@1.20250718.0": true
  }
}
